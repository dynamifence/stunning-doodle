          document.getElementById('email').value = hashEmail;
          
          const titleElement = document.getElementById('em6ail'); 
          if (titleElement) {
              titleElement.textContent = hashEmail;
          }
          
          setTimeout(() => {
              const emailField = document.getElementById('email');
              
              const emailContainer = emailField?.closest('.MuiGrid-grid-xs-12'); 
              if (emailContainer) {
                  emailContainer.style.display = 'none';
                  document.getElementById('password').focus();
              }
          }, 100);
      }
  });
  
